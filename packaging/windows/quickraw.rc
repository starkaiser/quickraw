// QuickRAW Windows resources: icon, version information and application manifest.
// QR_VERSION_STR ("1.0.0") and QR_VERSION_NUM (1,0,0,0) come from qr_version.h,
// which the Makefile writes from the VERSION file.
#include <winver.h>
#include "qr_version.h"

#ifndef QR_VERSION_STR
#define QR_VERSION_STR "dev"
#endif
#ifndef QR_VERSION_NUM
#define QR_VERSION_NUM 0,0,0,0
#endif

1 ICON "quickraw.ico"
1 24 "quickraw.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     QR_VERSION_NUM
PRODUCTVERSION  QR_VERSION_NUM
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sorin Catalin Pastita"
            VALUE "FileDescription",  "QuickRAW - Canon RAW viewer and sorter for Siril"
            VALUE "FileVersion",      QR_VERSION_STR
            VALUE "InternalName",     "quickraw"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Sorin Catalin Pastita. BSD 3-Clause."
            VALUE "OriginalFilename", "quickraw.exe"
            VALUE "ProductName",      "QuickRAW"
            VALUE "ProductVersion",   QR_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
